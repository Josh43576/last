# Flask session and browser login (replace all example values)
FLASK_SECRET_KEY=replace-with-a-long-random-secret
WEB_USERNAME=operator
WEB_PASSWORD=replace-with-a-long-password

# PZEM Modbus RTU bus
PZEM_PORT=/dev/ttyUSB0
PZEM_BAUDRATE=9600
PZEM_SLAVE_IDS=1,2,3
PZEM_TIMEOUT_SECONDS=0.5
POLL_INTERVAL_SECONDS=2
PZEM_VOLTAGE_SCALE=10
PZEM_CURRENT_SCALE=1000
PZEM_POWER_SCALE=10
PZEM_ENERGY_SCALE=1

# Relay outputs: BCM GPIO numbers; HIGH means ON and LOW means OFF
RELAY_GPIO_PINS=17,27,22

# Authorized decimal RFID IDs, comma separated. Empty disables RFID reset.
RFID_RESET_IDS=

# Bind to loopback for local-only use; use 0.0.0.0 for a trusted LAN.
WEB_HOST=0.0.0.0
WEB_PORT=5000
